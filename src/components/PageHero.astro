---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  anchors?: { id: string; label: string }[];
}

const { eyebrow, title, description, anchors } = Astro.props;
---
<section class="section-padding border-b border-border-subtle relative overflow-hidden">
  <div class="section-glow-top"></div>
  <div class="gold-glow w-[400px] h-[400px] top-0 left-1/2 -translate-x-1/2 opacity-50"></div>
  <div class="container-luxury relative z-10 text-center max-w-3xl">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1 class="text-3xl sm:text-4xl md:text-6xl font-serif font-bold text-text-white tracking-tight mb-6">
      {title}
    </h1>
    <div class="gold-divider mb-6"></div>
    {description && (
      <p class="text-lg md:text-xl text-text-ash leading-relaxed font-light">{description}</p>
    )}

    {anchors && anchors.length > 0 && (
      <nav class="anchor-nav mt-10 pt-8 border-t border-accent-gold/10" aria-label="Section navigation">
        {anchors.map((anchor, i) => (
          <span class="inline-flex items-center">
            {i > 0 && <span class="anchor-sep" aria-hidden="true">·</span>}
            <a href={`#${anchor.id}`}>{anchor.label}</a>
          </span>
        ))}
      </nav>
    )}
  </div>
</section>
