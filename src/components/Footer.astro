---
import BrandLogo from './BrandLogo.astro';
import { site, whatsappLink, telLink, googleMapsUrl, mailtoLink } from '../data/site';
import { navLinks } from '../data/nav';
---
<footer class="site-footer bg-zinc border-t border-border-subtle mt-auto relative">
  <div class="section-glow-top"></div>
  <div class="container-luxury py-8 sm:py-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-x-10 lg:gap-y-6">
      <div class="sm:col-span-2 lg:col-span-5">
        <BrandLogo variant="footer" class="mb-3" />
        <p class="text-sm text-text-ash leading-relaxed max-w-md mb-4">
          {site.tagline}. Pure vegetarian catering and full-scale event management since {site.yearEstablished}.
        </p>
        <p class="inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.15em] text-accent-gold/90">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-gold"></span>
          Pure Vegetarian · Luxury Events
        </p>
      </div>

      <div class="lg:col-span-3">
        <h3 class="footer-heading">Navigate</h3>
        <ul class="space-y-2">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-link">{link.name}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-4">
        <h3 class="footer-heading">Contact</h3>
        <dl class="space-y-3">
          <div>
            <dt class="footer-label">Phone</dt>
            <dd>
              <a href={telLink()} class="footer-link text-accent-gold hover:text-accent-gold-hover">
                {site.phone}
              </a>
            </dd>
          </div>
          <div>
            <dt class="footer-label">WhatsApp</dt>
            <dd>
              <a href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="footer-link">
                Chat with us
              </a>
              <p class="text-xs text-text-ash/70 mt-0.5 italic">"{site.whatsappMessage}"</p>
            </dd>
          </div>
          <div>
            <dt class="footer-label">Hours</dt>
            <dd class="footer-text">{site.businessHours}</dd>
          </div>
          <div>
            <dt class="footer-label">Email</dt>
            <dd>
              <a href={mailtoLink('General Inquiry')} class="footer-link break-all">
                {site.email}
              </a>
            </dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="footer-address mt-7">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div class="min-w-0 flex-1">
          <h3 class="footer-heading !mb-2 !pb-0 !border-0">Visit Us</h3>
          <address class="footer-text not-italic leading-relaxed">
            {site.addressLines.map((line) => (
              <span class="block">{line}</span>
            ))}
          </address>
          <p class="text-xs text-text-ash/70 mt-2">{site.serviceArea}</p>
        </div>
        <a
          href={googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline inline-flex items-center justify-center gap-2 text-xs !py-2.5 !px-4 shrink-0 w-full sm:w-auto"
        >
          <svg class="w-3.5 h-3.5 text-accent-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Open in Maps
        </a>
      </div>
    </div>

    <div class="mt-6 pt-5 border-t border-border-subtle flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-text-ash/80">
      <p>© {new Date().getFullYear()} {site.name}. All rights reserved.</p>
      <p>{site.location}</p>
    </div>
  </div>
</footer>

<style>
  .footer-heading {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-white);
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-border-subtle) 80%, transparent);
  }

  .footer-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-text-ash) 65%, transparent);
    margin-bottom: 0.125rem;
  }

  .footer-link {
    font-size: 0.875rem;
    color: var(--color-text-ash);
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--color-accent-gold);
  }

  .footer-text {
    font-size: 0.875rem;
    color: var(--color-text-ash);
  }

  .footer-address {
    padding: 1rem 1.125rem;
    background: color-mix(in srgb, var(--color-onyx) 35%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-border-subtle) 75%, transparent);
    border-radius: 0.5rem;
  }
</style>
