---
import type { MenuSection } from '../data/menu';

interface Props extends MenuSection {}

const { id, title, description, items } = Astro.props;
---
<section id={id} class="scroll-mt-32 md:scroll-mt-24 mb-12 md:mb-20 last:mb-0 reveal-on-scroll">
  <div class="mb-5 md:mb-8">
    <h2 class="text-xl md:text-3xl font-serif font-bold text-text-white mb-1 md:mb-2">{title}</h2>
    {description && <p class="text-sm text-text-ash font-light">{description}</p>}
    <div class="mt-3 md:mt-4 h-px w-full max-w-xs bg-gradient-to-r from-accent-gold/50 to-transparent"></div>
  </div>

  <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-0">
    {items.map((item) => (
      <li class="group py-2 md:py-3">
        <span class="text-[15px] text-text-white font-medium leading-snug group-hover:text-accent-gold transition-colors duration-200">
          {item.name}
        </span>
        {item.note && (
          <span class="block text-xs text-text-ash/70 mt-0.5 font-light">{item.note}</span>
        )}
      </li>
    ))}
  </ul>
</section>
