---
import type { MenuSection } from '../data/menu';
import { menuMoreDefault } from '../data/menu';
import NamedImage from './NamedImage.astro';

type Props = MenuSection;

const { id, title, description, items } = Astro.props;
---
<section id={id} class="scroll-mt-32 md:scroll-mt-24 mb-16 md:mb-24 last:mb-0 reveal-on-scroll">
  <div class="card-surface mb-7 md:mb-9">
    <div class="card-media aspect-[16/9] sm:aspect-[21/9] md:aspect-[3/1]">
      <NamedImage
        name={title}
        alt={title}
        class="transition-transform duration-700 hover:scale-[1.02]"
        sizes="(max-width: 1024px) 100vw, 800px"
      />
      <div class="absolute inset-0 z-[1] flex flex-col justify-end p-5 sm:p-7 md:p-9">
        <h2 class="text-xl sm:text-2xl md:text-3xl font-serif font-bold text-text-white mb-1 md:mb-2">{title}</h2>
        {description && (
          <p class="text-sm text-text-ash/90 font-light leading-relaxed max-w-2xl">{description}</p>
        )}
        <div class="mt-3 md:mt-4 h-px w-16 bg-accent-gold/60"></div>
      </div>
    </div>
  </div>

  <p class="text-xs text-text-ash/60 font-light mb-4 md:mb-5 italic">
    Sample selections — not an exhaustive list
  </p>

  <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-0">
    {items.map((item) => (
      <li class="group flex items-start gap-3 py-2.5 md:py-3 border-b border-border-subtle/50">
        <span class="mt-2 w-1.5 h-1.5 rounded-full bg-accent-gold/60 flex-shrink-0 group-hover:bg-accent-gold transition-colors"></span>
        <div class="min-w-0">
          <span class="text-[15px] text-text-white font-medium leading-snug group-hover:text-accent-gold transition-colors duration-200">
            {item.name}
          </span>
          {item.note && (
            <span class="block text-xs text-text-ash/70 mt-0.5 font-light">{item.note}</span>
          )}
        </div>
      </li>
    ))}
    <li class="flex items-start gap-3 py-2.5 md:py-3 sm:col-span-2 lg:col-span-3 border-b-0">
      <span class="mt-2 w-1.5 h-1.5 rounded-full bg-accent-gold/30 flex-shrink-0"></span>
      <p class="text-sm text-accent-gold/90 font-light italic leading-snug">{menuMoreDefault}</p>
    </li>
  </ul>
</section>
