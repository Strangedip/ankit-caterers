---
import { homeContent } from '../data/home';

const { highlights } = homeContent;
---
<section class="section-padding bg-zinc border-b border-border-subtle">
  <div class="container-luxury">
    <div class="text-center mb-14 reveal-on-scroll">
      <span class="eyebrow">Explore</span>
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-text-white">Everything We Offer</h2>
      <div class="gold-divider mt-6"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {highlights.map((item, i) => (
        <a
          href={item.href}
          class:list={[
            'group card-surface overflow-hidden transition-all duration-500 hover:-translate-y-1 reveal-on-scroll',
            i === 1 && 'stagger-1',
            i === 2 && 'stagger-2',
          ]}
        >
          <div class="h-48 overflow-hidden relative">
            <img
              src={item.image}
              alt={item.title}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-80 group-hover:opacity-100"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-zinc to-transparent"></div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-serif font-semibold text-text-white mb-2 group-hover:text-accent-gold transition-colors duration-300">
              {item.title}
            </h3>
            <p class="text-sm text-text-ash leading-relaxed">{item.description}</p>
            <span class="inline-flex items-center gap-1 mt-4 text-xs font-semibold text-accent-gold uppercase tracking-wider">
              Learn more
              <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
