---
import type { GalleryMedia } from '../data/gallery';
import MediaItem from './MediaItem.astro';

interface Props {
  id: string;
  title: string;
  description: string;
  items: GalleryMedia[];
}

const { id, title, description, items } = Astro.props;
---
<section id={id} class="scroll-mt-20 md:scroll-mt-24 mb-12 md:mb-20 last:mb-0 reveal-on-scroll">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3 mb-5 md:mb-8">
    <div>
      <h2 class="text-xl md:text-3xl font-serif font-bold text-text-white mb-1 md:mb-2">{title}</h2>
      <p class="text-sm text-text-ash font-light max-w-xl">{description}</p>
    </div>
    <div class="gold-divider mx-0 md:w-24 shrink-0"></div>
  </div>

  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
    {items.map((item) => (
      <MediaItem {...item} />
    ))}
  </div>
</section>
