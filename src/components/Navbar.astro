---
import { navLinks, isNavActive } from '../data/nav';
import BrandLogo from './BrandLogo.astro';
import { whatsappLink } from '../data/site';
import IconWhatsApp from './icons/IconWhatsApp.astro';

const currentPath = Astro.url.pathname;

const activeClass = 'text-accent-gold';
const inactiveClass = 'text-text-ash';
---
<header class="site-header bg-zinc border-b border-border-subtle/80 sticky top-0 z-50 relative">
  <div class="nav-gold-line"></div>
  <div class="container-luxury h-16 md:h-20 flex items-center justify-between gap-3">
    <BrandLogo />

    <nav class="hidden lg:flex items-center gap-10 text-sm font-medium" id="desktop-nav">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-nav-link={link.href}
          class:list={[
            'nav-link transition-colors duration-300 hover:text-accent-gold',
            isNavActive(link.href, currentPath) ? `${activeClass} nav-link-active` : inactiveClass,
          ]}
        >
          {link.name}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <a
        href={whatsappLink()}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:inline-flex btn-primary !px-6 !py-3 text-xs"
      >
        <IconWhatsApp class="w-4 h-4" />
        Book via WhatsApp
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="lg:hidden flex items-center justify-center w-11 h-11 rounded border border-border-subtle text-accent-gold hover:border-accent-gold hover:bg-accent-gold/5 transition-colors"
      >
        <svg id="menu-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu-wrap" class="mobile-menu-wrap lg:hidden" aria-hidden="true">
    <button
      id="mobile-menu-backdrop"
      type="button"
      aria-label="Close menu"
      class="mobile-menu-backdrop"
      tabindex="-1"
    ></button>

    <nav id="mobile-menu" class="mobile-menu-panel">
      <p class="text-xs font-semibold text-accent-gold uppercase tracking-[0.2em] mb-4 px-1">Menu</p>
      <div class="space-y-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            data-nav-link={link.href}
            data-nav-mobile
            class:list={[
              'nav-link-mobile block px-4 py-3.5 text-base font-medium rounded-lg transition-colors',
              isNavActive(link.href, currentPath)
                ? 'text-accent-gold bg-onyx border border-accent-gold/25'
                : 'hover:bg-border-subtle/40 hover:text-accent-gold text-text-ash',
            ]}
          >
            {link.name}
          </a>
        ))}
      </div>

      <div class="mt-6 pt-6 border-t border-border-subtle space-y-3">
        <a href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="btn-outline w-full text-sm !py-3.5">
          <IconWhatsApp class="w-4 h-4" />
          Book via WhatsApp
        </a>
        <a href="/contact" class="btn-primary w-full text-sm !py-3.5 text-center">
          Contact Us
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  function normalizePath(path) {
    const trimmed = path.split('?')[0].split('#')[0].replace(/\/index\.html$/, '').replace(/\/$/, '');
    return trimmed || '/';
  }

  function isActive(href, currentPath) {
    const path = normalizePath(currentPath);
    const target = normalizePath(href);
    if (target === '/') return path === '/';
    return path === target;
  }

  function updateNavActiveState() {
    const path = window.location.pathname;

    document.querySelectorAll('[data-nav-link]').forEach((link) => {
      const href = link.getAttribute('data-nav-link') || '/';
      const active = isActive(href, path);

      if (link.hasAttribute('data-nav-mobile')) {
        link.classList.toggle('text-accent-gold', active);
        link.classList.toggle('bg-onyx', active);
        link.classList.toggle('border', active);
        link.classList.toggle('border-accent-gold/25', active);
        link.classList.toggle('text-text-ash', !active);
      } else {
        link.classList.toggle('text-accent-gold', active);
        link.classList.toggle('text-text-ash', !active);
        link.classList.toggle('nav-link-active', active);
      }
    });
  }

  function getFocusable() {
    const btn = document.getElementById('mobile-menu-btn');
    const panel = document.getElementById('mobile-menu');
    const items = panel
      ? Array.from(panel.querySelectorAll('a, button'))
      : [];
    return [btn, ...items].filter((el) => el instanceof HTMLElement);
  }

  function setMobileMenuOpen(open) {
    const wrap = document.getElementById('mobile-menu-wrap');
    const btn = document.getElementById('mobile-menu-btn');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (!wrap || !btn) return;

    const wasOpen = wrap.classList.contains('is-open');
    wrap.classList.toggle('is-open', open);
    wrap.setAttribute('aria-hidden', String(!open));
    btn.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('mobile-nav-open', open);

    if (iconOpen && iconClose) {
      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
    }

    if (open) {
      const focusable = getFocusable();
      const firstLink = focusable.find((el) => el.id !== 'mobile-menu-btn');
      firstLink?.focus();
    } else if (wasOpen) {
      btn.focus();
    }
  }

  function closeMobileMenu() {
    setMobileMenuOpen(false);
  }

  function toggleMobileMenu() {
    const wrap = document.getElementById('mobile-menu-wrap');
    if (!wrap) return;
    setMobileMenuOpen(!wrap.classList.contains('is-open'));
  }

  function initNavbar() {
    updateNavActiveState();
    closeMobileMenu();
  }

  let navbarBound = false;

  if (!navbarBound) {
    navbarBound = true;

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      if (target.closest('#mobile-menu-btn')) {
        event.preventDefault();
        toggleMobileMenu();
        return;
      }

      if (target.closest('#mobile-menu-backdrop')) {
        closeMobileMenu();
        return;
      }

      if (target.closest('#mobile-menu a')) {
        closeMobileMenu();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeMobileMenu();
        return;
      }

      const wrap = document.getElementById('mobile-menu-wrap');
      if (!wrap?.classList.contains('is-open') || event.key !== 'Tab') return;

      const focusable = getFocusable();
      if (focusable.length === 0) return;

      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      const active = document.activeElement;

      if (event.shiftKey && active === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) closeMobileMenu();
    });

    document.addEventListener('astro:page-load', initNavbar);
  }

  initNavbar();
</script>

<style>
  .site-header {
    padding-top: env(safe-area-inset-top, 0px);
  }

  .mobile-menu-wrap {
    position: fixed;
    top: calc(4rem + env(safe-area-inset-top, 0px));
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    pointer-events: none;
    visibility: hidden;
  }

  .mobile-menu-wrap.is-open {
    pointer-events: auto;
    visibility: visible;
  }

  .mobile-menu-backdrop {
    position: absolute;
    inset: 0;
    border: none;
    background: rgba(10, 10, 10, 0.72);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.28s ease;
    cursor: pointer;
  }

  .mobile-menu-wrap.is-open .mobile-menu-backdrop {
    opacity: 1;
  }

  .mobile-menu-panel {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    max-height: calc(100dvh - 4rem - env(safe-area-inset-top, 0px));
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    background: #18181B;
    border-top: 1px solid #27272A;
    padding: 1.25rem 1.5rem 2rem;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.45);
    transform: translateY(-8px);
    opacity: 0;
    transition: transform 0.28s ease, opacity 0.28s ease;
  }

  @media (min-width: 768px) {
    .mobile-menu-wrap {
      top: calc(5rem + env(safe-area-inset-top, 0px));
    }

    .mobile-menu-panel {
      max-height: calc(100dvh - 5rem - env(safe-area-inset-top, 0px));
    }
  }

  .mobile-menu-wrap.is-open .mobile-menu-panel {
    transform: translateY(0);
    opacity: 1;
  }

  :global(body.mobile-nav-open) {
    overflow: hidden;
  }
</style>
