---
import { navLinks, isNavActive } from '../data/nav';
import BrandLogo from './BrandLogo.astro';
import { whatsappLink } from '../data/site';
import IconWhatsApp from './icons/IconWhatsApp.astro';

const currentPath = Astro.url.pathname;

const activeClass = 'text-accent-gold';
const inactiveClass = 'text-text-ash';
---
<header class="site-header bg-zinc border-b border-border-subtle/80 sticky top-0 z-50" transition:persist="site-header">
  <div class="nav-gold-line"></div>
  <div class="container-luxury h-16 md:h-20 flex items-center justify-between gap-3">
    <BrandLogo />

    <nav class="hidden lg:flex items-center gap-10 text-sm font-medium" id="desktop-nav">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-nav-link={link.href}
          class:list={[
            'nav-link transition-colors duration-300 hover:text-accent-gold',
            isNavActive(link.href, currentPath) ? `${activeClass} nav-link-active` : inactiveClass,
          ]}
        >
          {link.name}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <a
        href={whatsappLink()}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:inline-flex btn-primary !px-6 !py-3 text-xs"
      >
        <IconWhatsApp class="w-4 h-4" />
        Book via WhatsApp
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden flex items-center justify-center w-11 h-11 rounded border border-border-subtle text-accent-gold hover:border-accent-gold hover:bg-accent-gold/5 transition-colors"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<div
  id="mobile-nav"
  class="mobile-nav"
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
  transition:persist="site-mobile-nav"
>
  <div class="mobile-nav-bar">
    <BrandLogo />
    <button
      id="mobile-nav-close"
      type="button"
      class="flex items-center justify-center w-11 h-11 rounded border border-border-subtle text-accent-gold hover:border-accent-gold hover:bg-accent-gold/5 transition-colors"
      aria-label="Close menu"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav class="mobile-nav-links" aria-label="Mobile">
    {navLinks.map((link) => (
      <a
        href={link.href}
        data-nav-link={link.href}
        data-nav-mobile
        class:list={[
          'mobile-nav-link',
          isNavActive(link.href, currentPath) && 'is-active',
        ]}
      >
        {link.name}
      </a>
    ))}
  </nav>

  <div class="mobile-nav-actions">
    <a href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="btn-outline w-full text-sm !py-3.5">
      <IconWhatsApp class="w-4 h-4" />
      Book via WhatsApp
    </a>
    <a href="/contact" class="btn-primary w-full text-sm !py-3.5 text-center">
      Contact Us
    </a>
  </div>
</div>

<script>
  const DESKTOP_MIN = 1024;
  let scrollLockY = 0;
  let bound = false;

  function normalizePath(path) {
    const trimmed = path.split('?')[0].split('#')[0].replace(/\/index\.html$/, '').replace(/\/$/, '');
    return trimmed || '/';
  }

  function isActive(href, currentPath) {
    const path = normalizePath(currentPath);
    const target = normalizePath(href);
    if (target === '/') return path === '/';
    return path === target;
  }

  function menuEls() {
    return {
      nav: document.getElementById('mobile-nav'),
      openBtn: document.getElementById('mobile-menu-btn'),
      closeBtn: document.getElementById('mobile-nav-close'),
    };
  }

  function isMenuOpen() {
    return document.documentElement.classList.contains('nav-open');
  }

  function focusables() {
    const { nav } = menuEls();
    if (!nav) return [];
    return Array.from(
      nav.querySelectorAll('a, button')
    ).filter((el) => el instanceof HTMLElement && !el.hasAttribute('disabled'));
  }

  function lockPageScroll() {
    scrollLockY = window.scrollY;
    document.documentElement.classList.add('nav-open');
    document.body.style.top = `-${scrollLockY}px`;
  }

  function unlockPageScroll() {
    document.documentElement.classList.remove('nav-open');
    document.body.style.top = '';
    window.scrollTo(0, scrollLockY);
  }

  function setMenuOpen(open) {
    const { nav, openBtn, closeBtn } = menuEls();
    if (!nav || !openBtn) return;

    if (window.innerWidth >= DESKTOP_MIN) open = false;

    const wasOpen = isMenuOpen();

    nav.hidden = !open;
    nav.classList.toggle('is-open', open);
    nav.inert = !open;
    openBtn.setAttribute('aria-expanded', String(open));
    openBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');

    if (open && !wasOpen) {
      lockPageScroll();
      closeBtn?.focus();
      return;
    }

    if (!open && wasOpen) {
      unlockPageScroll();
      openBtn.focus();
    }
  }

  function closeMenu() {
    setMenuOpen(false);
  }

  function openMenu() {
    if (window.innerWidth >= DESKTOP_MIN) return;
    setMenuOpen(true);
  }

  function toggleMenu() {
    if (isMenuOpen()) closeMenu();
    else openMenu();
  }

  function updateActiveLinks() {
    const path = window.location.pathname;
    document.querySelectorAll('[data-nav-link]').forEach((link) => {
      const href = link.getAttribute('data-nav-link') || '/';
      const active = isActive(href, path);
      if (link.hasAttribute('data-nav-mobile')) {
        link.classList.toggle('is-active', active);
      } else {
        link.classList.toggle('text-accent-gold', active);
        link.classList.toggle('text-text-ash', !active);
        link.classList.toggle('nav-link-active', active);
      }
    });
  }

  function onDocumentClick(event) {
    const target = event.target;
    if (!(target instanceof Element)) return;

    if (target.closest('#mobile-menu-btn')) {
      event.preventDefault();
      toggleMenu();
      return;
    }

    if (target.closest('#mobile-nav-close')) {
      event.preventDefault();
      closeMenu();
      return;
    }

    if (target.closest('#mobile-nav a')) {
      closeMenu();
    }
  }

  function onDocumentKeydown(event) {
    if (event.key === 'Escape' && isMenuOpen()) {
      closeMenu();
      return;
    }

    if (!isMenuOpen() || event.key !== 'Tab') return;

    const items = focusables();
    if (items.length === 0) return;

    const first = items[0];
    const last = items[items.length - 1];
    const active = document.activeElement;

    if (event.shiftKey && active === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && active === last) {
      event.preventDefault();
      first.focus();
    }
  }

  function onResize() {
    if (window.innerWidth >= DESKTOP_MIN && isMenuOpen()) closeMenu();
  }

  function init() {
    updateActiveLinks();
    closeMenu();
  }

  if (!bound) {
    bound = true;
    document.addEventListener('click', onDocumentClick);
    document.addEventListener('keydown', onDocumentKeydown);
    window.addEventListener('resize', onResize);
    document.addEventListener('astro:page-load', init);
  }

  init();
</script>
