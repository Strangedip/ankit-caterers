---
import { navLinks, isNavActive } from '../data/nav';
import BrandLogo from './BrandLogo.astro';
import { whatsappLink } from '../data/site';

const currentPath = Astro.url.pathname;

const activeClass = 'text-accent-gold';
const inactiveClass = 'text-text-ash';
---
<header class="site-header bg-zinc border-b border-border-subtle/80 sticky top-0 z-50 relative">
  <div class="nav-gold-line"></div>
  <div class="container-luxury h-16 md:h-20 flex items-center justify-between gap-3">
    <BrandLogo />

    <nav class="hidden lg:flex items-center gap-10 text-sm font-medium" id="desktop-nav">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-nav-link={link.href}
          class:list={[
            'nav-link transition-colors duration-300 hover:text-accent-gold',
            isNavActive(link.href, currentPath) ? `${activeClass} nav-link-active` : inactiveClass,
          ]}
        >
          {link.name}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <a
        href={whatsappLink()}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:inline-flex btn-primary !px-6 !py-3 text-xs"
      >
        Book via WhatsApp
      </a>

      <a
        href={whatsappLink()}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Book via WhatsApp"
        class="md:hidden flex items-center justify-center w-10 h-10 rounded border border-[#25D366]/40 bg-[#25D366]/10 text-[#25D366] hover:bg-[#25D366]/20 transition-colors"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
        </svg>
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="lg:hidden flex items-center justify-center w-10 h-10 rounded border border-border-subtle text-accent-gold hover:border-accent-gold hover:bg-accent-gold/5 transition-colors"
      >
        <svg id="menu-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu-wrap" class="mobile-menu-wrap lg:hidden" aria-hidden="true">
    <button
      id="mobile-menu-backdrop"
      type="button"
      aria-label="Close menu"
      class="mobile-menu-backdrop"
      tabindex="-1"
    ></button>

    <nav id="mobile-menu" class="mobile-menu-panel">
      <p class="text-xs font-semibold text-accent-gold uppercase tracking-[0.2em] mb-4 px-1">Menu</p>
      <div class="space-y-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            data-nav-link={link.href}
            data-nav-mobile
            class:list={[
              'nav-link-mobile block px-4 py-3.5 text-base font-medium rounded-lg transition-colors',
              isNavActive(link.href, currentPath)
                ? 'text-accent-gold bg-onyx border border-accent-gold/25'
                : 'hover:bg-border-subtle/40 hover:text-accent-gold text-text-ash',
            ]}
          >
            {link.name}
          </a>
        ))}
      </div>

      <div class="mt-6 pt-6 border-t border-border-subtle space-y-3">
        <a href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="btn-whatsapp w-full text-sm !py-3.5">
          Book via WhatsApp
        </a>
        <a href="/contact" class="btn-outline w-full text-sm !py-3.5 text-center">
          Contact Us
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  function normalizePath(path) {
    const trimmed = path.split('?')[0].split('#')[0].replace(/\/index\.html$/, '').replace(/\/$/, '');
    return trimmed || '/';
  }

  function isActive(href, currentPath) {
    const path = normalizePath(currentPath);
    const target = normalizePath(href);
    if (target === '/') return path === '/';
    return path === target;
  }

  function updateNavActiveState() {
    const path = window.location.pathname;

    document.querySelectorAll('[data-nav-link]').forEach((link) => {
      const href = link.getAttribute('data-nav-link') || '/';
      const active = isActive(href, path);

      if (link.hasAttribute('data-nav-mobile')) {
        link.classList.toggle('text-accent-gold', active);
        link.classList.toggle('bg-onyx', active);
        link.classList.toggle('border', active);
        link.classList.toggle('border-accent-gold/25', active);
        link.classList.toggle('text-text-ash', !active);
      } else {
        link.classList.toggle('text-accent-gold', active);
        link.classList.toggle('text-text-ash', !active);
        link.classList.toggle('nav-link-active', active);
      }
    });
  }

  function setMobileMenuOpen(open) {
    const wrap = document.getElementById('mobile-menu-wrap');
    const btn = document.getElementById('mobile-menu-btn');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (!wrap || !btn) return;

    wrap.classList.toggle('is-open', open);
    wrap.setAttribute('aria-hidden', String(!open));
    btn.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('mobile-nav-open', open);

    if (iconOpen && iconClose) {
      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
    }
  }

  function closeMobileMenu() {
    setMobileMenuOpen(false);
  }

  function toggleMobileMenu() {
    const wrap = document.getElementById('mobile-menu-wrap');
    if (!wrap) return;
    setMobileMenuOpen(!wrap.classList.contains('is-open'));
  }

  function initNavbar() {
    updateNavActiveState();
    closeMobileMenu();
  }

  let navbarBound = false;

  if (!navbarBound) {
    navbarBound = true;

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      if (target.closest('#mobile-menu-btn')) {
        event.preventDefault();
        toggleMobileMenu();
        return;
      }

      if (target.closest('#mobile-menu-backdrop')) {
        closeMobileMenu();
        return;
      }

      if (target.closest('#mobile-menu a')) {
        closeMobileMenu();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMobileMenu();
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) closeMobileMenu();
    });

    document.addEventListener('astro:page-load', initNavbar);
  }

  initNavbar();
</script>

<style>
  .mobile-menu-wrap {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
    visibility: hidden;
  }

  .mobile-menu-wrap.is-open {
    pointer-events: auto;
    visibility: visible;
  }

  .mobile-menu-backdrop {
    position: absolute;
    inset: 0;
    border: none;
    background: rgba(10, 10, 10, 0.72);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.28s ease;
    cursor: pointer;
  }

  .mobile-menu-wrap.is-open .mobile-menu-backdrop {
    opacity: 1;
  }

  .mobile-menu-panel {
    position: absolute;
    top: 4rem;
    left: 0;
    right: 0;
    max-height: calc(100dvh - 4rem);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    background: #18181B;
    border-top: 1px solid #27272A;
    padding: 1.25rem 1.5rem 2rem;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.45);
    transform: translateY(-8px);
    opacity: 0;
    transition: transform 0.28s ease, opacity 0.28s ease;
  }

  @media (min-width: 768px) {
    .mobile-menu-panel {
      top: 5rem;
      max-height: calc(100dvh - 5rem);
    }
  }

  .mobile-menu-wrap.is-open .mobile-menu-panel {
    transform: translateY(0);
    opacity: 1;
  }

  :global(body.mobile-nav-open) {
    overflow: hidden;
  }
</style>
