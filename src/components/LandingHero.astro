---
import { homeContent } from '../data/home';
import { whatsappInquiry, telLink, site } from '../data/site';
import IconPhone from './icons/IconPhone.astro';
import IconWhatsApp from './icons/IconWhatsApp.astro';
import OptimizedImage from './OptimizedImage.astro';

const { hero, stats } = homeContent;

function renderHeadline(full: string, accent: string) {
  const idx = full.indexOf(accent);
  if (idx === -1) return full;
  return {
    before: full.slice(0, idx),
    accent,
    after: full.slice(idx + accent.length),
  };
}

const parts = renderHeadline(hero.headline, hero.headlineAccent);
---
<section class="relative overflow-hidden flex items-center border-b border-border-subtle">
  <div class="absolute inset-0 z-0 overflow-hidden">
    <OptimizedImage
      src={hero.image}
      alt={hero.imageAlt}
      cover
      class="hero-bg-image"
      loading="eager"
      fetchpriority="high"
      widths={[640, 960, 1400, 1800]}
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-onyx via-onyx/85 to-onyx/50"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-onyx/70 via-transparent to-onyx/70"></div>
  </div>

  <div class="hero-shine-line top-0"></div>
  <div class="gold-glow w-[400px] h-[400px] top-1/4 left-1/2 -translate-x-1/2"></div>

  <div class="container-luxury relative z-10 pt-16 pb-10 sm:pt-24 sm:pb-16 md:pt-32 md:pb-20 flex flex-col items-center text-center">
    <span class="badge-glow mb-5 animate-fade-up">
      <span class="dot-pulse"></span>
      {hero.eyebrow}
    </span>

    <h1 class="hero-brand-name animate-fade-up max-w-4xl" style="animation-delay: 0.05s">
      {hero.businessName.split(' & ')[0]}
      <span>& {hero.businessName.split(' & ')[1]}</span>
    </h1>

    <div class="gold-divider-wide mb-6 mt-4 animate-fade-up" style="animation-delay: 0.1s"></div>

    <p class="text-xl sm:text-4xl lg:text-5xl font-serif font-bold tracking-tight leading-[1.2] mb-4 max-w-5xl text-text-white animate-fade-up px-1 text-balance" style="animation-delay: 0.15s">
      {typeof parts === 'string' ? (
        parts
      ) : (
        <>
          {parts.before}
          <span class="headline-accent">{parts.accent}</span>
          {parts.after}
        </>
      )}
    </p>

    <p class="text-base sm:text-xl leading-relaxed max-w-2xl mb-3 font-light text-text-ash animate-fade-up" style="animation-delay: 0.2s">
      {hero.subheadline}
    </p>
    <p class="text-xs sm:text-sm uppercase tracking-[0.18em] text-accent-gold/90 mb-8 animate-fade-up" style="animation-delay: 0.22s">
      {site.locationShort}
    </p>

    <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto animate-fade-up" style="animation-delay: 0.3s">
      <a href={whatsappInquiry('Event booking inquiry')} target="_blank" rel="noopener noreferrer" class="btn-primary w-full sm:w-auto">
        <IconWhatsApp class="w-4 h-4" />
        WhatsApp
      </a>
      <a href={telLink()} class="btn-outline w-full sm:w-auto text-text-white">
        <IconPhone class="w-4 h-4" />
        Call
      </a>
    </div>

    <div class="mt-10 sm:mt-16 grid grid-cols-3 gap-3 sm:gap-6 md:gap-16 pt-6 border-t border-accent-gold/15 w-full max-w-2xl animate-fade-up" style="animation-delay: 0.4s">
      {stats.map((stat) => (
        <div>
          <div class="stat-glow">{stat.value}</div>
          <div class="text-xs md:text-sm text-text-ash mt-1 uppercase tracking-wider leading-snug">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
