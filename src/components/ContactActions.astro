---
import { site, mailtoLink, whatsappInquiry, telLink } from '../data/site';
import IconPhone from './icons/IconPhone.astro';
import IconWhatsApp from './icons/IconWhatsApp.astro';
---
<div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mb-8">
  <div class="card-surface p-6 md:p-8 text-center border-accent-gold/30 reveal-on-scroll">
    <div class="inline-flex items-center justify-center w-14 h-14 bg-onyx border border-accent-gold/40 rounded-full mb-5">
      <IconWhatsApp class="w-6 h-6" />
    </div>
    <h2 class="text-lg font-serif font-semibold text-text-white mb-2">WhatsApp — Preferred</h2>
    <p class="text-text-ash text-sm mb-2">Send us:</p>
    <p class="text-accent-gold font-medium mb-6 italic">"{site.whatsappMessage}"</p>
    <a href={whatsappInquiry()} target="_blank" rel="noopener noreferrer" class="btn-outline w-full">
      <IconWhatsApp class="w-4 h-4" />
      Chat on WhatsApp
    </a>
  </div>

  <div class="card-surface p-6 md:p-8 text-center reveal-on-scroll stagger-1">
    <div class="inline-flex items-center justify-center w-14 h-14 bg-onyx border border-border-subtle rounded-full mb-5">
      <IconPhone class="w-6 h-6 text-accent-gold" />
    </div>
    <h2 class="text-lg font-serif font-semibold text-text-white mb-2">Call Us</h2>
    <a href={telLink()} class="text-xl text-accent-gold hover:text-accent-gold-hover font-medium transition-colors block mb-2">
      {site.phone}
    </a>
    <p class="text-text-ash text-sm mb-6">{site.businessHours}</p>
    <a href={telLink()} class="btn-primary w-full">
      <IconPhone class="w-4 h-4" />
      Call Now
    </a>
  </div>
</div>

<div class="card-surface p-5 md:p-6 text-center reveal-on-scroll max-w-xl mx-auto">
  <p class="text-xs text-text-ash uppercase tracking-wider mb-2">Last resort</p>
  <h2 class="text-sm font-serif font-semibold text-text-white mb-2">Email</h2>
  <a href={mailtoLink('General Inquiry')} class="text-sm text-text-ash hover:text-accent-gold transition-colors break-all min-h-11 inline-flex items-center">
    {site.email}
  </a>
</div>
