---
import { site, mailtoLink, whatsappInquiry, telLink } from '../data/site';
import IconPhone from './icons/IconPhone.astro';
import IconWhatsApp from './icons/IconWhatsApp.astro';
---
<div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 items-stretch">
  <div class="card-surface card-surface-accent p-6 md:p-8 text-center reveal-on-scroll flex flex-col">
    <div class="inline-flex items-center justify-center w-14 h-14 bg-onyx border border-accent-gold/40 rounded-full mb-5 mx-auto">
      <IconWhatsApp class="w-6 h-6" />
    </div>
    <h2 class="text-lg font-serif font-semibold text-text-white mb-2">WhatsApp — Preferred</h2>
    <p class="text-text-ash text-sm mb-2">Send us:</p>
    <p class="text-accent-gold font-medium mb-6 italic">"{site.whatsappMessage}"</p>
    <a href={whatsappInquiry()} target="_blank" rel="noopener noreferrer" class="btn-primary w-full mt-auto">
      <IconWhatsApp class="w-4 h-4" />
      Chat on WhatsApp
    </a>
  </div>

  <div class="card-surface p-6 md:p-8 text-center reveal-on-scroll stagger-1 flex flex-col">
    <div class="inline-flex items-center justify-center w-14 h-14 bg-onyx border border-border-subtle rounded-full mb-5 mx-auto">
      <IconPhone class="w-6 h-6 text-accent-gold" />
    </div>
    <h2 class="text-lg font-serif font-semibold text-text-white mb-2">Call Us</h2>
    <a href={telLink()} class="text-xl text-accent-gold hover:text-accent-gold-hover font-medium transition-colors block mb-2">
      {site.phone}
    </a>
    <p class="text-text-ash text-sm mb-6">{site.businessHours}</p>
    <a href={telLink()} class="btn-outline w-full mt-auto">
      <IconPhone class="w-4 h-4" />
      Call Now
    </a>
  </div>
</div>

<a
  href={mailtoLink('General Inquiry')}
  class="card-surface card-surface-interactive mt-4 md:mt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 px-5 py-4 md:px-6 reveal-on-scroll"
>
  <div class="flex items-start sm:items-center gap-3 min-w-0">
    <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-onyx border border-border-subtle shrink-0">
      <svg class="w-4 h-4 text-accent-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>
    </span>
    <span class="min-w-0">
      <span class="block text-[11px] uppercase tracking-[0.16em] text-text-ash/80 mb-0.5">If you prefer email</span>
      <span class="block text-sm text-text-white break-all">{site.email}</span>
    </span>
  </div>
  <span class="text-xs font-semibold uppercase tracking-wider text-accent-gold inline-flex items-center gap-1 shrink-0">
    Write to us
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </span>
</a>
