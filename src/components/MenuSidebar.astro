---
interface Props {
  sections: { id: string; title: string }[];
}

const { sections } = Astro.props;
---
<nav class="lg:sticky lg:top-28 lg:self-start reveal-on-scroll" aria-label="Menu sections">
  <p class="text-xs font-semibold text-accent-gold uppercase tracking-[0.2em] mb-4 hidden lg:block">Sections</p>
  <ul class="flex lg:flex-col gap-1 overflow-x-auto lg:overflow-visible pb-2 lg:pb-0 -mx-1 px-1 lg:mx-0 lg:px-0">
    {sections.map((section) => (
      <li class="shrink-0 lg:shrink">
        <a
          href={`#${section.id}`}
          class="block text-sm text-text-ash hover:text-accent-gold transition-colors duration-200 px-3 py-2 lg:px-0 lg:py-1.5 whitespace-nowrap lg:whitespace-normal border-b-2 border-transparent hover:border-accent-gold/40 lg:border-0"
        >
          {section.title}
        </a>
      </li>
    ))}
  </ul>
</nav>
