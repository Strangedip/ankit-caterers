---
interface Props {
  sections: { id: string; title: string }[];
}

const { sections } = Astro.props;
---
<nav
  class="menu-sidebar sticky top-16 z-20 -mx-4 px-4 py-2 mb-6 bg-onyx/95 backdrop-blur-sm border-b border-border-subtle lg:mx-0 lg:px-0 lg:py-0 lg:mb-0 lg:border-0 lg:bg-transparent lg:backdrop-blur-none lg:top-28 lg:self-start reveal-on-scroll"
  aria-label="Menu sections"
  style="top: calc(4rem + env(safe-area-inset-top, 0px))"
>
  <p class="text-xs font-semibold text-accent-gold uppercase tracking-[0.2em] mb-4 hidden lg:block">Sections</p>
  <div class="chip-nav-fade chip-nav-fade--sidebar">
    <ul class="chip-nav pr-9 lg:pr-0 lg:flex-col lg:overflow-visible lg:snap-none lg:pb-0 lg:gap-1">
    {sections.map((section) => (
      <li class="shrink-0 lg:shrink lg:w-full">
        <a
          href={`#${section.id}`}
          class="lg:flex lg:items-center lg:w-full lg:rounded-none lg:border-0 lg:border-b-2 lg:border-transparent lg:px-0 lg:py-2 lg:normal-case lg:tracking-normal lg:font-medium lg:text-sm whitespace-nowrap lg:whitespace-normal"
        >
          {section.title}
        </a>
      </li>
    ))}
    </ul>
  </div>
</nav>

<style>
  @media (min-width: 768px) {
    .menu-sidebar {
      top: calc(5rem + env(safe-area-inset-top, 0px));
    }
  }

  @media (min-width: 1024px) {
    .menu-sidebar {
      top: 7rem;
    }
  }
</style>
