---
import { whatsappInquiry } from '../data/site';
import type { SiteImage } from '../data/images';
import IconWhatsApp from './icons/IconWhatsApp.astro';
import OptimizedImage from './OptimizedImage.astro';

interface Props {
  title: string;
  description?: string;
  priceLabel?: string;
  features: string[];
  image: SiteImage;
  inquirySubject: string;
}

const { title, description, priceLabel, features, image, inquirySubject } = Astro.props;
---
<article class="group card-lift card-lift--md flex flex-col h-full reveal-on-scroll">
  <div class="card-surface flex flex-col h-full">
    <div class="card-media h-40 md:h-56">
      <OptimizedImage
        src={image}
        alt={`${title} catering package by Ankit Caterers`}
        cover
        class="transition-transform duration-700 group-hover:scale-[1.03] opacity-90 group-hover:opacity-100"
        sizes="(max-width: 768px) 100vw, 33vw"
      />
    {priceLabel && (
      <span class="absolute top-4 right-4 z-[5] bg-zinc/90 backdrop-blur-sm border border-accent-gold/50 text-accent-gold text-xs font-semibold px-4 py-1.5 rounded uppercase tracking-wider">
        {priceLabel}
      </span>
    )}
    </div>

    <div class="p-5 md:p-8 flex flex-col flex-grow">
    <h3 class="text-xl md:text-2xl font-serif font-semibold mb-2 group-hover:text-accent-gold transition-colors">{title}</h3>
    {description && <p class="text-sm text-text-ash mb-5 md:mb-6 leading-relaxed">{description}</p>}

    <ul class="space-y-3 mb-6 md:mb-8 flex-grow">
      {features.map((feature) => (
        <li class="flex items-start text-sm text-text-ash leading-relaxed">
          <svg class="w-4 h-4 text-accent-gold mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {feature}
        </li>
      ))}
    </ul>

    <a
      href={whatsappInquiry(inquirySubject)}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-outline w-full text-center mt-auto text-sm"
    >
      <IconWhatsApp class="w-4 h-4" />
      Inquire on WhatsApp
    </a>
    </div>
  </div>
</article>
