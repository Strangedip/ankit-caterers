---
import { faqs } from '../data/site';
---
<section class="section-padding border-b border-border-subtle">
  <div class="container-luxury max-w-3xl">
    <div class="text-center mb-8 md:mb-10 reveal-on-scroll">
      <span class="eyebrow">Common Questions</span>
      <h2 class="text-2xl md:text-4xl font-serif font-bold text-text-white">Before You Book</h2>
      <div class="gold-divider mt-4 md:mt-6"></div>
    </div>

    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="card-surface group px-5 py-4 reveal-on-scroll">
          <summary class="cursor-pointer list-none flex items-start justify-between gap-3 min-h-11 text-text-white font-serif font-semibold text-base md:text-lg">
            {faq.question}
            <span class="text-accent-gold shrink-0 mt-1 group-open:rotate-45 transition-transform" aria-hidden="true">+</span>
          </summary>
          <p class="text-sm md:text-base text-text-ash leading-relaxed font-light mt-3 pb-1">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
