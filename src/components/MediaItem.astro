---
import type { GalleryMedia } from '../data/gallery';

type Props = GalleryMedia;

const props = Astro.props;
---
<figure class="group relative overflow-hidden rounded border border-border-subtle aspect-[4/3] bg-onyx">
  {props.type === 'image' ? (
    <>
      <img
        src={props.src}
        alt={props.alt}
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-90 group-hover:opacity-100"
        loading="lazy"
      />
      <figcaption class="absolute inset-0 bg-gradient-to-t from-onyx via-onyx/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
        <p class="text-xs font-medium text-text-white">{props.alt}</p>
      </figcaption>
    </>
  ) : (
    <>
      <video
        src={props.src}
        poster={props.poster}
        class="w-full h-full object-cover"
        controls
        preload="metadata"
        aria-label={props.alt}
      >
        <track kind="captions" />
      </video>
      <figcaption class="absolute bottom-0 left-0 right-0 p-3 bg-onyx/80 text-xs text-text-ash">
        {props.alt}
      </figcaption>
    </>
  )}
</figure>
