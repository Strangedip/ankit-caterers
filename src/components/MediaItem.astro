---
import type { GalleryMedia } from '../data/gallery';
import OptimizedImage from './OptimizedImage.astro';

type Props = GalleryMedia;

const props = Astro.props;
---
<figure class="group relative overflow-hidden rounded border border-border-subtle bg-onyx">
  {props.type === 'image' ? (
    <>
      <div class="relative aspect-[4/3] overflow-hidden bg-onyx">
        <OptimizedImage
          src={props.src}
          alt={props.alt}
          cover
          class="transition-transform duration-700 group-hover:scale-105 opacity-90 group-hover:opacity-100"
          sizes="(max-width: 640px) 50vw, (max-width: 1024px) 50vw, 25vw"
          width={800}
          height={600}
        />
      </div>
      <figcaption class="px-3 py-2.5 text-xs font-medium text-text-ash leading-snug border-t border-border-subtle">
        {props.alt}
      </figcaption>
    </>
  ) : (
    <>
      <video
        src={props.src}
        poster={props.poster}
        class="w-full aspect-[4/3] object-cover"
        controls
        preload="metadata"
        aria-label={props.alt}
      >
        <track kind="captions" />
      </video>
      <figcaption class="px-3 py-2.5 text-xs text-text-ash border-t border-border-subtle">
        {props.alt}
      </figcaption>
    </>
  )}
</figure>
