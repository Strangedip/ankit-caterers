---
import type { GalleryMedia } from '../data/gallery';
import OptimizedImage from './OptimizedImage.astro';

type Props = GalleryMedia;

const { src, alt } = Astro.props;
---
<figure class="group card-surface card-surface-interactive bg-onyx">
  <div class="card-media aspect-[4/3] bg-onyx">
    <OptimizedImage
      src={src}
      alt={alt}
      cover
      class="transition-transform duration-700 group-hover:scale-[1.03] opacity-90 group-hover:opacity-100"
      sizes="(max-width: 640px) 50vw, (max-width: 1024px) 50vw, 25vw"
    />
  </div>
  <figcaption class="px-3 py-2.5 text-xs font-medium text-text-ash leading-snug">
    {alt}
  </figcaption>
</figure>
