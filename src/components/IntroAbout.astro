---
import { homeContent } from '../data/home';
import OptimizedImage from './OptimizedImage.astro';

const { intro } = homeContent;
---
<section class="section-padding border-b border-border-subtle">
  <div class="container-luxury">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
      <div class="reveal-on-scroll">
        <span class="eyebrow">{intro.eyebrow}</span>
        <h2 class="text-2xl md:text-5xl font-serif font-bold text-text-white tracking-tight mb-4 md:mb-6">
          {intro.title}
        </h2>
        <div class="gold-divider mx-0 mb-6 md:mb-8"></div>
        {intro.paragraphs.map((p) => (
          <p class="text-base md:text-lg text-text-ash leading-relaxed mb-4 md:mb-6 font-light">{p}</p>
        ))}
        <a href="/services" class="inline-flex items-center gap-2 min-h-11 text-sm font-medium text-accent-gold hover:text-accent-gold-hover transition-colors group mt-1">
          Discover our services
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <div class="reveal-on-scroll stagger-2 relative">
        <div class="image-frame-glow"></div>
        <div class="rounded overflow-hidden aspect-[4/3] lg:aspect-auto lg:h-[480px] border border-accent-gold/15 relative">
          <div class="absolute inset-0 bg-gradient-to-t from-onyx/50 to-transparent z-10"></div>
          <OptimizedImage
            src={intro.image}
            alt={intro.imageAlt}
            cover
            sizes="(max-width: 1024px) 100vw, 50vw"
          />
        </div>
      </div>
    </div>
  </div>
</section>
