---
import { telLink, whatsappInquiry } from '../data/site';
import IconPhone from './icons/IconPhone.astro';
import IconWhatsApp from './icons/IconWhatsApp.astro';
---
<nav
  class="mobile-dock lg:hidden"
  aria-label="Quick contact"
>
  <a href={telLink()} class="mobile-dock-item">
    <IconPhone class="w-5 h-5" />
    <span>Call</span>
  </a>
  <span class="mobile-dock-sep" aria-hidden="true"></span>
  <a
    href={whatsappInquiry()}
    target="_blank"
    rel="noopener noreferrer"
    class="mobile-dock-item"
  >
    <IconWhatsApp class="w-5 h-5" />
    <span>WhatsApp</span>
  </a>
</nav>
