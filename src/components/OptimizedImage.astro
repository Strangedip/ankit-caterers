---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  cover?: boolean;
}

const {
  src,
  alt,
  class: className,
  widths = [400, 800, 1200],
  sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 800px',
  loading = 'lazy',
  fetchpriority,
  cover = false,
} = Astro.props;

const coverStyle = cover
  ? 'position:absolute;inset:0;width:100%;height:100%;max-width:none;object-fit:cover;object-position:center;'
  : undefined;
---
<Image
  src={src}
  alt={alt}
  class:list={[
    className,
    cover && 'absolute inset-0 w-full h-full object-cover object-center',
  ]}
  style={coverStyle}
  widths={widths}
  sizes={sizes}
  loading={loading}
  fetchpriority={fetchpriority}
/>
