---
import { whatsappInquiry } from '../data/site';

interface Props {
  title: string;
  description: string;
  features: string[];
  image: string;
  inquirySubject: string;
}

const { title, description, features, image, inquirySubject } = Astro.props;
---
<article class="card-surface overflow-hidden group hover:border-accent-gold transition-all duration-500 reveal-on-scroll">
  <div class="grid grid-cols-1 md:grid-cols-2">
    <div class="h-56 md:h-auto min-h-[220px] overflow-hidden">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        loading="lazy"
      />
    </div>
    <div class="p-8 flex flex-col justify-center">
      <h3 class="text-2xl font-serif font-semibold text-text-white mb-3 group-hover:text-accent-gold transition-colors">{title}</h3>
      <p class="text-sm text-text-ash leading-relaxed mb-5">{description}</p>
      <ul class="space-y-2 mb-6">
        {features.map((f) => (
          <li class="flex items-center gap-2 text-sm text-text-ash">
            <span class="w-1 h-1 rounded-full bg-accent-gold flex-shrink-0"></span>
            {f}
          </li>
        ))}
      </ul>
      <a
        href={whatsappInquiry(inquirySubject)}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-whatsapp self-start text-xs !py-2.5 !px-5"
      >
        Inquire on WhatsApp
      </a>
    </div>
  </div>
</article>
