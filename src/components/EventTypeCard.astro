---
import { whatsappInquiry } from '../data/site';
import type { SiteImage } from '../data/images';
import IconWhatsApp from './icons/IconWhatsApp.astro';
import OptimizedImage from './OptimizedImage.astro';

interface Props {
  title: string;
  description: string;
  features: string[];
  image: SiteImage;
  inquirySubject: string;
}

const { title, description, features, image, inquirySubject } = Astro.props;
---
<article class="group card-surface card-surface-interactive reveal-on-scroll">
  <div class="flex flex-col md:grid md:grid-cols-2">
    <div class="card-media w-full aspect-[16/10] md:aspect-auto md:min-h-[220px]">
      <OptimizedImage
        src={image}
        alt={`${title} by Ankit Caterers in Kalyan`}
        cover
        class="transition-transform duration-700 group-hover:scale-[1.03]"
        sizes="(max-width: 768px) 100vw, 50vw"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-onyx/40 via-transparent to-transparent md:from-onyx/20 pointer-events-none"></div>
    </div>
    <div class="p-5 md:p-8 flex flex-col justify-center">
      <h3 class="text-lg md:text-2xl font-serif font-semibold text-text-white mb-2 md:mb-3 group-hover:text-accent-gold transition-colors">{title}</h3>
      <p class="text-sm text-text-ash leading-relaxed mb-3 md:mb-5">{description}</p>
      <ul class="space-y-1.5 md:space-y-2 mb-4 md:mb-6">
        {features.map((f) => (
          <li class="flex items-center gap-2 text-sm text-text-ash">
            <span class="w-1 h-1 rounded-full bg-accent-gold flex-shrink-0"></span>
            {f}
          </li>
        ))}
      </ul>
      <a
        href={whatsappInquiry(inquirySubject)}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-outline self-start text-sm !py-2.5 !px-4 min-h-11"
      >
        <IconWhatsApp class="w-4 h-4" />
        Inquire
      </a>
    </div>
  </div>
</article>
