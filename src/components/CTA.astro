---
import { site, whatsappInquiry, telLink } from '../data/site';
import IconPhone from './icons/IconPhone.astro';
import IconWhatsApp from './icons/IconWhatsApp.astro';

interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
}

const {
  title = 'Ready to Elevate Your Next Event?',
  description = 'WhatsApp or call us directly — we respond to every inquiry within two hours.',
  buttonText = 'WhatsApp',
} = Astro.props;
---
<section class="cta-band border-t border-border-subtle relative overflow-hidden">
  <div class="section-glow-top"></div>
  <div class="absolute inset-0 bg-zinc/40"></div>
  <div class="gold-glow w-[500px] h-[500px] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"></div>

  <div class="container-luxury relative z-10 text-center max-w-3xl reveal-on-scroll">
    <span class="eyebrow">Begin Your Journey</span>
    <h2 class="text-2xl md:text-5xl font-serif font-bold text-text-white tracking-tight mb-4 md:mb-6">{title}</h2>
    <div class="gold-divider mb-4 md:mb-6"></div>
    <p class="text-base md:text-lg text-text-ash leading-relaxed font-light mb-6 md:mb-8">{description}</p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href={telLink()} class="btn-primary">
        <IconPhone class="w-4 h-4" />
        Call {site.phone}
      </a>
      <a href={whatsappInquiry()} target="_blank" rel="noopener noreferrer" class="btn-outline text-text-white">
        <IconWhatsApp class="w-4 h-4" />
        {buttonText}
      </a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-block: 2rem;
  }

  @media (min-width: 768px) {
    .cta-band {
      padding-block: 3.5rem;
    }
  }
</style>
