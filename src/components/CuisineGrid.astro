---
import type { CuisineItem } from '../data/services';
import NamedImage from './NamedImage.astro';

interface Props {
  cuisines: CuisineItem[];
}

const { cuisines } = Astro.props;

const icons: Record<CuisineItem['icon'], string> = {
  north: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
  south: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9',
  gujarati: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
  jain: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  chinese: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  continental: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064',
  live: 'M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z',
};
---
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5">
  {cuisines.map((cuisine) => (
    <article class="group card-surface card-surface-interactive reveal-on-scroll">
      <div class="card-media h-36 md:h-44">
        <NamedImage
          name={cuisine.name}
          alt={cuisine.name}
          overlay={false}
          class="transition-transform duration-700 group-hover:scale-[1.03] opacity-90 group-hover:opacity-100"
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-zinc via-zinc/10 to-transparent pointer-events-none"></div>
      </div>
      <div class="p-4 md:p-5">
        <div class="flex items-start gap-3 mb-1.5 md:mb-2">
          <div class="inline-flex items-center justify-center w-8 h-8 bg-onyx border border-accent-gold/25 rounded-full flex-shrink-0 mt-0.5">
            <svg class="w-3.5 h-3.5 text-accent-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={icons[cuisine.icon]} />
            </svg>
          </div>
          <h3 class="text-base md:text-lg font-serif font-semibold text-text-white group-hover:text-accent-gold transition-colors">{cuisine.name}</h3>
        </div>
        <p class="text-xs md:text-sm text-text-ash leading-relaxed pl-11">{cuisine.description}</p>
      </div>
    </article>
  ))}
</div>
