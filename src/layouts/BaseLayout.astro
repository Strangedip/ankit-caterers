---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MobileDock from '../components/MobileDock.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import JsonLd from '../components/JsonLd.astro';
import { site, seo } from '../data/site';
import siteIcon from '../assets/icon.png';
import ogImage from '../assets/logo.png';

interface Props {
  pageTitle: string;
  description?: string;
  title?: string;
}

const {
  pageTitle,
  description = seo.homeDescription,
  title,
} = Astro.props;

const fullTitle = title ?? (
  pageTitle === 'Home'
    ? seo.homeTitle
    : `${pageTitle} | ${site.shortName} Kalyan`
);

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://ankitcaterers.in');
const origin = canonicalUrl.origin;
const ogImageUrl = new URL(ogImage.src, origin).href;
---
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0A0A" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl.href} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={seo.ogLocale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={`${site.name} logo`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap"
    />

    <link rel="icon" type="image/png" href={siteIcon.src} sizes="130x104" />
    <link rel="shortcut icon" type="image/png" href={siteIcon.src} />
    <link rel="apple-touch-icon" href={siteIcon.src} />
    <title>{fullTitle}</title>
    <JsonLd canonicalUrl={canonicalUrl} />
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col bg-onyx">
    <Navbar />

    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
    <MobileDock />
    <ScrollReveal />
  </body>
</html>
