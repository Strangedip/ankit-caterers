---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import GallerySection from '../components/GallerySection.astro';
import CTA from '../components/CTA.astro';
import { galleryPage } from '../data/gallery';
---
<BaseLayout
  pageTitle="Event Gallery"
  description="Wedding catering, birthday setups, and corporate events by Ankit Caterers in Kalyan East — browse our vegetarian catering gallery from Thane and Mumbai."
>
  <PageHero
    eyebrow={galleryPage.hero.eyebrow}
    title={galleryPage.hero.title}
    description={galleryPage.hero.description}
    backgroundImage={galleryPage.hero.image}
    backgroundAlt={galleryPage.hero.imageAlt}
  />

  <section class="section-padding">
    <div class="container-luxury">
      <nav
        class="gallery-chips sticky z-20 -mx-4 px-4 py-2 mb-8 bg-onyx/95 backdrop-blur-sm border-b border-border-subtle md:static md:mx-0 md:px-0 md:py-0 md:mb-12 md:bg-transparent md:backdrop-blur-none md:border-0 reveal-on-scroll"
        aria-label="Gallery sections"
        style="top: calc(4rem + env(safe-area-inset-top, 0px))"
      >
        <div class="chip-nav-fade md:[&::after]:hidden">
          <div class="chip-nav justify-start pr-9 md:pr-0 md:flex-wrap md:overflow-visible md:snap-none md:justify-center">
          {galleryPage.sections.map((section) => (
            <a href={`#${section.id}`}>{section.title}</a>
          ))}
          </div>
        </div>
      </nav>

      {galleryPage.sections.map((section) => (
        <GallerySection {...section} items={[...section.items]} />
      ))}
    </div>
  </section>

  <CTA />
</BaseLayout>

<style>
  @media (min-width: 768px) {
    .gallery-chips {
      top: auto;
    }
  }
</style>
