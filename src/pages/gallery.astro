---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import GallerySection from '../components/GallerySection.astro';
import CTA from '../components/CTA.astro';
import { galleryPage } from '../data/gallery';
import { whatsappInquiry } from '../data/site';
import IconWhatsApp from '../components/icons/IconWhatsApp.astro';
---
<BaseLayout
  pageTitle="Event Gallery"
  description="Wedding catering, birthday setups, and corporate events by Ankit Caterers in Kalyan East — browse our vegetarian catering gallery from Thane and Mumbai."
>
  <PageHero
    eyebrow={galleryPage.hero.eyebrow}
    title={galleryPage.hero.title}
    description={galleryPage.hero.description}
  />

  <section class="section-padding">
    <div class="container-luxury">
      <nav
        class="gallery-chips sticky z-20 -mx-4 px-4 py-2 mb-8 bg-onyx/95 backdrop-blur-sm border-b border-border-subtle md:static md:mx-0 md:px-0 md:py-0 md:mb-12 md:bg-transparent md:backdrop-blur-none md:border-0 reveal-on-scroll"
        aria-label="Gallery sections"
        style="top: calc(4rem + env(safe-area-inset-top, 0px))"
      >
        <div class="chip-nav-fade md:[&::after]:hidden">
          <div class="chip-nav justify-start md:flex-wrap md:overflow-visible md:snap-none md:justify-center">
          {galleryPage.sections.map((section) => (
            <a href={`#${section.id}`}>{section.title}</a>
          ))}
          </div>
        </div>
      </nav>

      {galleryPage.sections.map((section) => (
        <GallerySection {...section} items={[...section.items]} />
      ))}

      <div class="card-surface p-6 md:p-14 text-center mt-8 reveal-on-scroll">
        <h2 class="text-2xl md:text-3xl font-serif font-bold text-text-white mb-4">Inspired by What You See?</h2>
        <p class="text-text-ash mb-6 max-w-xl mx-auto font-light">
          Share your event vision and we will bring it to life with the same precision and elegance across Kalyan, Thane, and Mumbai.
        </p>
        <a href={whatsappInquiry('Gallery — Book Consultation')} target="_blank" rel="noopener noreferrer" class="btn-outline">
          <IconWhatsApp class="w-4 h-4" />
          Book via WhatsApp
        </a>
      </div>
    </div>
  </section>

  <CTA buttonText="WhatsApp" />
</BaseLayout>

<style>
  @media (min-width: 768px) {
    .gallery-chips {
      top: auto;
    }
  }
</style>
