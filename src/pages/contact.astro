---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactActions from '../components/ContactActions.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { site } from '../data/site';
---
<BaseLayout
  pageTitle="Contact"
  description={`Contact Ankit Caterers in Kalyan East — call or WhatsApp for pure vegetarian catering and event management in Thane, Mumbai, Dombivli & Ulhasnagar. ${site.phone}`}
>
  <section class="section-padding border-b border-border-subtle">
    <div class="container-luxury">
      <div class="text-center max-w-2xl mx-auto mb-8 md:mb-10">
        <span class="eyebrow">Get in Touch</span>
        <h1 class="text-2xl sm:text-4xl md:text-5xl font-serif font-bold text-text-white tracking-tight mb-4">
          Let's Plan Your Event
        </h1>
        <div class="gold-divider mb-4"></div>
        <p class="text-base md:text-lg text-text-ash leading-relaxed font-light">
          Reach out by WhatsApp or phone — we respond to every inquiry within two hours during business hours.
        </p>
      </div>
      <ContactActions />
    </div>
  </section>

  <section class="section-padding bg-zinc border-b border-border-subtle">
    <div class="container-luxury">
      <div class="text-center mb-8 md:mb-12 reveal-on-scroll">
        <span class="eyebrow">Our Service Area</span>
        <h2 class="text-2xl md:text-4xl font-serif font-bold text-text-white mb-4">Find Us on the Map</h2>
        <div class="gold-divider mb-4"></div>
        <address class="not-italic text-text-ash font-light max-w-xl mx-auto leading-relaxed">
          {site.addressLines.map((line) => (
            <span class="block">{line}</span>
          ))}
        </address>
        <p class="text-sm text-accent-gold mt-3">{site.serviceArea}</p>
      </div>
      <div class="reveal-on-scroll">
        <MapEmbed />
      </div>
    </div>
  </section>
</BaseLayout>
