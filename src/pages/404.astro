---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  pageTitle="Page Not Found"
  description="The page you are looking for could not be found."
>
  <section class="section-padding border-b border-border-subtle">
    <div class="container-luxury text-center max-w-xl">
      <span class="eyebrow">404</span>
      <h1 class="text-4xl md:text-5xl font-serif font-bold text-text-white mb-4">Page Not Found</h1>
      <div class="gold-divider mb-6"></div>
      <p class="text-text-ash leading-relaxed mb-8">
        The page you requested does not exist or may have been moved.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="btn-primary">Back to Home</a>
        <a href="/contact" class="btn-outline text-text-white">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>
