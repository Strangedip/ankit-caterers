---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import MenuSection from '../components/MenuSection.astro';
import MenuSidebar from '../components/MenuSidebar.astro';
import CTA from '../components/CTA.astro';
import { menuPage } from '../data/menu';
import { whatsappInquiry } from '../data/site';
import IconWhatsApp from '../components/icons/IconWhatsApp.astro';

const sectionNav = menuPage.sections.map((s) => ({
  id: s.id,
  title: s.title,
}));
---
<BaseLayout
  pageTitle="Vegetarian Catering Menu"
  description="Pure vegetarian catering menu in Kalyan — starters, live counters, Jain-friendly mains, and desserts by Ankit Caterers for weddings and events in Thane & Mumbai."
>
  <PageHero
    eyebrow={menuPage.hero.eyebrow}
    title={menuPage.hero.title}
    description={menuPage.hero.description}
    backgroundImage={menuPage.hero.image}
    backgroundAlt={menuPage.hero.imageAlt}
  />

  <section class="section-padding">
    <div class="container-luxury max-w-6xl">
      <div class="grid grid-cols-1 lg:grid-cols-[200px_1fr] gap-6 lg:gap-16">
        <MenuSidebar sections={sectionNav} />

        <div>
          {menuPage.sections.map((section) => (
            <MenuSection {...section} items={[...section.items]} />
          ))}

          <div class="mt-4 pt-8 border-t border-border-subtle text-center reveal-on-scroll">
            <p class="text-sm text-text-ash font-light mb-5 max-w-lg mx-auto">
              The dishes above are representative samples only. We offer many more options across every category — share your preferences and we will build a fully custom menu for your event in Kalyan, Thane, or Mumbai.
            </p>
            <a href={whatsappInquiry('Custom Menu Inquiry')} target="_blank" rel="noopener noreferrer" class="btn-outline">
              <IconWhatsApp class="w-4 h-4" />
              Request Menu on WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>
